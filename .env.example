# Copier en .env et ajuster
PORT=3000
HOST=0.0.0.0

# Secret JWT - OBLIGATOIRE A CHANGER EN PRODUCTION
JWT_SECRET=change-me-in-production-please

# Chemin DB (par defaut database/culture-radar.db)
# DB_PATH=/var/data/culture-radar.db

# ---- OpenAgenda (pour obtenir des evenements culturels reels) ----
# 1) Creer un compte gratuit : https://openagenda.com/register
# 2) Recuperer votre cle secrete : https://openagenda.com/profile/api
# 3) Decoller la ligne ci-dessous et y coller votre cle :
# OPENAGENDA_KEY=votre-cle-ici
#
# Pour un agenda specifique (recommande), recuperer son UID dans l URL
# (ex : https://openagenda.com/ile-de-france -> UID visible dans la page admin)
# OPENAGENDA_AGENDA_UID=12345678
#
# Ou, a defaut, un mot-cle pour rechercher automatiquement des agendas :
# OPENAGENDA_SEARCH=paris

# Google Tag Manager - optionnel, injecte dans index.html cote client
# GTM_ID=GTM-XXXXXXX

# Autoriser le CORS pour un autre domaine front (prod)
# CORS_ORIGIN=https://culture-radar.fr
